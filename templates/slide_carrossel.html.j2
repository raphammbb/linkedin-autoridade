<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
{% include "_base.css.j2" %}
    .cap-titulo {
      font-size: 76px;
      font-weight: 900;
      line-height: 1.14;
      letter-spacing: -0.01em;
      white-space: pre-line;
    }
    .cap-subtitulo {
      font-size: 30px;
      font-weight: 500;
      color: var(--li-text-dim);
      margin-top: 28px;
      max-width: 820px;
    }
    .cont-titulo {
      font-size: 48px;
      font-weight: 800;
      line-height: 1.22;
      margin-bottom: 44px;
      white-space: pre-line;
    }
    .bullets { list-style: none; display: flex; flex-direction: column; gap: 28px; }
    .bullets li {
      font-size: 32px;
      font-weight: 500;
      line-height: 1.4;
      padding-left: 44px;
      position: relative;
    }
    .bullets li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 14px;
      width: 20px;
      height: 6px;
      border-radius: 3px;
      background: var(--li-accent);
    }
    .cont-corpo {
      font-size: 34px;
      font-weight: 500;
      line-height: 1.5;
      color: var(--li-text);
    }
    .cta-chamada {
      font-size: 60px;
      font-weight: 800;
      line-height: 1.2;
      white-space: pre-line;
    }
    .cta-acao {
      font-size: 32px;
      font-weight: 700;
      color: var(--li-accent);
      margin-top: 40px;
    }
    .cta-pergunta {
      font-size: 30px;
      font-weight: 500;
      color: var(--li-text-dim);
      margin-top: 20px;
      max-width: 820px;
    }
    .middle {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
</style>
</head>
<body>
  <div class="frame">
    {% if tipo == "capa" %}
      <div class="kicker">Rapha · marketing &amp; IA</div>
      <div class="accent-bar"></div>
      <div class="middle">
        <div class="cap-titulo">{{ titulo }}</div>
        {% if subtitulo %}<div class="cap-subtitulo">{{ subtitulo }}</div>{% endif %}
      </div>
    {% elif tipo == "conteudo" %}
      <div class="middle">
        <div class="cont-titulo">{{ titulo }}</div>
        {% if bullets %}
        <ul class="bullets">
          {% for b in bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% elif corpo %}
        <div class="cont-corpo">{{ corpo }}</div>
        {% endif %}
      </div>
    {% elif tipo == "cta" %}
      <div class="middle">
        <div class="cta-chamada">{{ chamada }}</div>
        {% if acao %}<div class="cta-acao">{{ acao }}</div>{% endif %}
        {% if pergunta %}<div class="cta-pergunta">{{ pergunta }}</div>{% endif %}
      </div>
    {% endif %}
    <div class="swipe-hint">{{ "Arraste →" if tipo != "cta" else "" }}</div>
    <div class="counter">{{ "%02d"|format(index) }}/{{ "%02d"|format(total) }}</div>
  </div>
</body>
</html>
