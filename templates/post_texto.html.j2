<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
{% include "_base.css.j2" %}
    .titulo {
      font-size: {{ titulo_size|default(68) }}px;
      font-weight: 800;
      line-height: 1.18;
      letter-spacing: -0.01em;
      color: var(--li-text);
      white-space: pre-line;
    }
    .destaque {
      font-size: 220px;
      font-weight: 900;
      color: var(--li-accent);
      line-height: 1;
      letter-spacing: -0.02em;
      margin-bottom: 28px;
    }
    .corpo {
      font-size: 30px;
      font-weight: 500;
      color: var(--li-text-dim);
      line-height: 1.4;
      margin-top: 40px;
      max-width: 820px;
    }
    .middle {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
</style>
</head>
<body>
  <div class="frame">
    <div class="kicker">{{ pilar_label }}</div>
    <div class="accent-bar"></div>
    <div class="middle">
      {% if destaque %}<div class="destaque">{{ destaque }}</div>{% endif %}
      <div class="titulo">{{ titulo }}</div>
      {% if corpo %}<div class="corpo">{{ corpo }}</div>{% endif %}
    </div>
  </div>
</body>
</html>
